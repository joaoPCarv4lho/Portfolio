---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Tag from '../ui/Tag.astro';
import { skillGroups } from '../../data/skills';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Section id="skills">
  <SectionHeading index="02" title={t('skills.title')} subtitle={t('skills.subtitle')}>
    Stack
  </SectionHeading>

  <div class="grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
    {
      skillGroups.map((group, i) => (
        <article
          class="bg-canvas p-6 transition-colors hover:bg-surface md:p-8"
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
        >
          <div class="mb-2 flex items-baseline gap-3">
            <span class="font-mono text-xs text-accent">{`0${i + 1}`}</span>
            <h3 class="text-lg font-semibold text-ink">{group.title}</h3>
          </div>

          <p class="mb-5 text-sm text-muted text-pretty">{group.description}</p>

          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li>
                <Tag>{item}</Tag>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
