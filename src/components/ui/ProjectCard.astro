---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import Tag from './Tag.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
const t = useTranslations(getLangFromUrl(Astro.url));

const narrative = [
  { label: t('projects.problem'), text: data.problem },
  { label: t('projects.solution'), text: data.solution },
  { label: t('projects.result'), text: data.result },
];
---

<article
  class="group relative grid gap-6 border-t border-line py-10 md:grid-cols-[auto_1fr] md:gap-10 md:py-14"
  data-reveal
>
  {/* Numeração da coluna esquerda; no mobile fica na mesma linha do título. */}
  <div class="flex items-center gap-3 md:flex-col md:items-start md:gap-2">
    <span class="font-mono text-2xl font-medium text-accent tabular-nums md:text-3xl">
      {String(index + 1).padStart(2, '0')}
    </span>
    {data.period && <span class="font-mono text-xs whitespace-nowrap text-muted">{data.period}</span>}
  </div>

  <div>
    <header class="mb-6">
      <h3 class="text-2xl font-semibold text-balance text-ink md:text-3xl">{data.title}</h3>
      <p class="mt-2 text-base text-muted text-pretty">{data.tagline}</p>

      {
        data.confidential && (
          <p class="mt-3 inline-flex items-center gap-2 font-mono text-xs text-muted/70">
            <span class="size-1 rounded-full bg-muted/50" />
            {t('projects.confidential')}
          </p>
        )
      }
    </header>

    {
      data.cover && (
        <img
          src={data.cover}
          alt={`Interface do projeto ${data.title}`}
          width="1200"
          height="750"
          loading="lazy"
          decoding="async"
          class="mb-6 w-full rounded-lg border border-line"
        />
      )
    }

    <dl class="space-y-5 border-l border-line pl-5">
      {
        narrative.map((block) => (
          <div>
            <dt class="mb-1.5 font-mono text-xs tracking-widest text-accent uppercase">{block.label}</dt>
            <dd class="text-sm leading-relaxed text-muted text-pretty md:text-base">{block.text}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="mt-7 flex flex-wrap gap-2">
      {
        data.stack.map((item) => (
          <li>
            <Tag>{item}</Tag>
          </li>
        ))
      }
    </ul>

    <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
      {
        data.repo ? (
          <a
            href={data.repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-mono text-sm text-ink transition-colors hover:text-accent"
          >
            <Icon name="github" class="size-4" />
            {t('projects.repo')}
          </a>
        ) : (
          <span class="inline-flex items-center gap-2 font-mono text-sm text-muted/50">
            <Icon name="github" class="size-4" />
            {t('projects.soon')}
          </span>
        )
      }

      {
        data.demo && (
          <a
            href={data.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-mono text-sm text-ink transition-colors hover:text-accent"
          >
            <Icon name="external" class="size-4" />
            {t('projects.demo')}
          </a>
        )
      }
    </div>
  </div>
</article>
