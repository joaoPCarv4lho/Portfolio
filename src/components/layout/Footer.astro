---
import Icon from '../ui/Icon.astro';
import { contact, site } from '../../data/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-10">
  <div class="shell flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
    <div class="font-mono text-xs text-muted">
      <p>© {year} {site.name}. {t('footer.rights')}</p>
      <p class="mt-1">{t('footer.built')}</p>
    </div>

    <div class="flex items-center gap-1">
      <a
        href={`mailto:${contact.email}`}
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-accent"
        aria-label="E-mail"
      >
        <Icon name="mail" class="size-4" />
      </a>
      <a
        href={contact.github}
        target="_blank"
        rel="noopener noreferrer"
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-accent"
        aria-label="GitHub"
      >
        <Icon name="github" class="size-4" />
      </a>
      <a
        href={contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-accent"
        aria-label="LinkedIn"
      >
        <Icon name="linkedin" class="size-4" />
      </a>
    </div>
  </div>
</footer>
