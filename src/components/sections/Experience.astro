---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Tag from '../ui/Tag.astro';
import { experience } from '../../data/experience';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Section id="experiencia">
  <SectionHeading index="04" title={t('experience.title')}>
    Trajetória profissional
  </SectionHeading>

  <ol class="relative space-y-12 border-l border-line pl-6 md:pl-10">
    {
      experience.map((item, i) => (
        <li class="relative" data-reveal style={`--reveal-delay:${i * 100}ms`}>
          {/* Marcador na timeline; preenchido quando é a posição atual. */}
          <span
            class:list={[
              'absolute top-2 -left-[1.72rem] size-3 rounded-full border-2 md:-left-[2.72rem]',
              item.end === null ? 'border-accent bg-accent' : 'border-line-strong bg-canvas',
            ]}
            aria-hidden="true"
          />

          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <p class="font-mono text-xs text-muted">{item.period}</p>
            {item.end === null && (
              <span class="rounded-full bg-accent-soft px-2 py-0.5 font-mono text-[0.6875rem] text-accent">
                {t('experience.current')}
              </span>
            )}
          </div>

          <h3 class="mt-2 text-xl font-semibold text-ink md:text-2xl">{item.role}</h3>
          <p class="mt-1 text-base text-accent">{item.company}</p>
          <p class="mt-3 max-w-2xl text-sm text-muted text-pretty md:text-base">{item.summary}</p>

          <ul class="mt-4 space-y-2">
            {item.highlights.map((highlight) => (
              <li class="flex gap-3 text-sm text-muted text-pretty">
                <span class="mt-2 size-1 shrink-0 rounded-full bg-accent/60" aria-hidden="true" />
                {highlight}
              </li>
            ))}
          </ul>

          <ul class="mt-5 flex flex-wrap gap-2">
            {item.stack.map((tech) => (
              <li>
                <Tag>{tech}</Tag>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
