---
interface Props {
  /** `accent` destaca a tag; `muted` é o padrão para listas de stack. */
  variant?: 'muted' | 'accent';
}

const { variant = 'muted' } = Astro.props;

const styles = {
  muted: 'border-line bg-elevated text-muted',
  accent: 'border-accent/30 bg-accent-soft text-accent',
} as const;
---

<span
  class:list={[
    'inline-flex items-center rounded border px-2 py-1 font-mono text-xs whitespace-nowrap',
    styles[variant],
  ]}
>
  <slot />
</span>
